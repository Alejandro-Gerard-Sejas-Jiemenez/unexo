# Plantilla del .env para el servidor de la FICCT.
# Copiar como .env EN EL SERVIDOR y completar DB_PASSWORD. El .env real nunca
# se versiona: .gitignore ignora todo .env* salvo estas plantillas.

APP_NAME="NEXO SIS"
APP_ENV=production
# Generar en el servidor con: php artisan key:generate
APP_KEY=
APP_DEBUG=false

# Con la ruta del grupo incluida: de aquí salen las URL de los assets y el
# basename del router de React. Sin la subruta, la SPA no encuentra la API.
APP_URL=https://www.tecnoweb.org.bo/inf513/grupo06sa/proyecto2

APP_TIMEZONE=America/La_Paz
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_LEVEL=warning

# --- Base de datos institucional -------------------------------------------
# La base del grupo es compartida: el Proyecto 1 (sistema por correo) vive en
# el schema `unexo` y otros proyectos de la materia ocupan `public`. Esta
# aplicación usa su propio schema `unexo_web` para no pisar nada.
DB_CONNECTION=pgsql
DB_HOST=db.tecnoweb.org.bo
DB_PORT=5432
DB_DATABASE=db_grupo06sa
DB_USERNAME=grupo06sa
DB_PASSWORD=
DB_SEARCH_PATH=unexo_web
DB_SSLMODE=prefer

# --- Sesión ------------------------------------------------------------------
# La SPA se autentica con la cookie de sesión, así que esto importa.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# La ruta del grupo: evita que la cookie se pise con la de otro proyecto.
SESSION_PATH=/inf513/grupo06sa/proyecto2
SESSION_DOMAIN=www.tecnoweb.org.bo
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=sync

# Dominios que pueden autenticarse con cookie (Sanctum).
SANCTUM_STATEFUL_DOMAINS=www.tecnoweb.org.bo
